# ==========================================================================
# Mock Interview backend (PHP) -> Dograh voice-agent integration
# Copy this file to `.env` and fill in the values. NEVER commit the real .env.
# Same variable names as the Python backend.
# ==========================================================================

# --- Dograh instance ------------------------------------------------------
# Base URL of the Dograh backend for THIS deployment (no default; set per host).
DOGRAH_BASE_URL=http://<dograh-host>:8000
# Optional: override the WebSocket base used for signaling (http->ws by default).
# DOGRAH_WS_BASE_URL=ws://<dograh-host>:8000
DOGRAH_WORKFLOW_ID=3
DOGRAH_WORKFLOW_UUID=c7aa4967-4365-4bb7-95f1-b77ce3d944de

# --- Dograh auth ----------------------------------------------------------
# Provide an API key (preferred, sent as X-API-Key) and/or an embed token.
DOGRAH_API_KEY=
# Pre-created embed token for the workflow (used to start voice sessions).
DOGRAH_EMBED_TOKEN=

# Comma-separated domains allowed to embed the widget (empty = any origin).
EMBED_ALLOWED_DOMAINS=

# --- WebRTC ICE -----------------------------------------------------------
ICE_STUN_URLS=stun:stun.l.google.com:19302

# --- Computer-vision (dlib/opencv Flask) API ------------------------------
CV_API_URL=http://127.0.0.1:5001

# --- Post-interview AI evaluation -----------------------------------------
# The PHP backend calls the provider directly (no LiteLLM). Supported model
# prefixes: "gemini/..." (Google Generative Language API), "openrouter/...",
# "openai/..." / "gpt-..." (OpenAI-compatible). Leave empty to disable.
EVAL_LLM_MODEL=gemini/gemini-flash-latest
EVAL_LLM_API_KEY=
# Optional custom OpenAI-compatible base URL (used for non-Gemini models).
# EVAL_LLM_API_BASE=

# --- Report persistence ---------------------------------------------------
# Folder where each generated report is saved (one <interview_id>.json).
REPORTS_DIR=data/reports

# --- This backend ---------------------------------------------------------
HOST=0.0.0.0
PORT=8080
CORS_ORIGINS=*
