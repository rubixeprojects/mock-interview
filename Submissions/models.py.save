        related_name="team",
        primary_key=True,  # email is PK for this table
    )
    team_preference = models.BooleanField(db_column="TeamPreference", default=False)
    team_id = models.CharField(db_column="TeamID", max_length=50, unique=True)
    team_count = models.PositiveIntegerField(db_column="TeamCount", default=0)

