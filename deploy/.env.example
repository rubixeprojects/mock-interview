# =============================================================================
# LiteLLM + Dograh deployment — copy to `.env` and fill in.
# NEVER commit the real .env. No provider API keys are required here; add
# models (and their keys) from the LiteLLM UI after startup.
# =============================================================================

# --- REQUIRED: the server's own IP (LAN or public). NOT localhost/127.0.0.1 ---
# Every browser-facing URL (LiteLLM UI, Dograh API/WebRTC, MinIO) is built from
# this, so it must be an address other machines can reach.
HOST_IP=192.168.1.30

# -----------------------------------------------------------------------------
# LiteLLM
# -----------------------------------------------------------------------------
# Master key clients pass as the API key. Must start with "sk-".
#   generate: echo "sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=
# Salt used to encrypt provider keys stored in the DB. Do NOT change after first
# run (it would make stored keys undecryptable).
#   generate: openssl rand -hex 32
LITELLM_SALT_KEY=
# Admin UI login (http://<HOST_IP>:4000/ui)
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=

# LiteLLM shares the Dograh Postgres instance (below) as the `postgres` user;
# it just uses a separate database, created automatically on first start.
LITELLM_DB_NAME=litellm

# -----------------------------------------------------------------------------
# Dograh
# -----------------------------------------------------------------------------
# REQUIRED strong secret for OSS auth tokens.
#   generate: openssl rand -hex 32
OSS_JWT_SECRET=

# Datastore credentials.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=

# Allow public signup in the Dograh UI (set false for invite-only).
ENABLE_SIGNUP=true
# uvicorn workers for the Dograh API.
FASTAPI_WORKERS=1
# Product telemetry (PostHog). Off by default for a private deployment.
ENABLE_TELEMETRY=false

# Image registry/tags for Dograh (defaults to Docker Hub `dograhai`).
DOGRAH_REGISTRY=dograhai

# -----------------------------------------------------------------------------
# Windmill (minimal: server + 1 worker, sharing the Postgres above)
# -----------------------------------------------------------------------------
# Separate database on the shared Postgres, created automatically on first start.
WINDMILL_DB_NAME=windmill
# Windmill image (override to pin a version, e.g. ...windmill:1.x.y).
WINDMILL_IMAGE=ghcr.io/windmill-labs/windmill:main

# NOTE: the SKILLOGIC Freshchat webhook is now its OWN standalone compose project
# (../skillogic-webhook) with its own .env — see skillogic-webhook/.env.example.
# It is no longer part of this stack.

# -----------------------------------------------------------------------------
# OPTIONAL — only if you want to pre-declare models in litellm-config.yaml
# instead of adding them from the UI. Reference as os.environ/VAR_NAME there.
# -----------------------------------------------------------------------------
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
